# Copy to keystore.properties (gitignored) and fill in.
# Create the keystore once:
#   keytool -genkeypair -v -keystore release/gocast-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias gocast
#
# Back up the .jks and this file — losing them means you cannot update the same app signing identity.

storeFile=release/gocast-upload.jks
storePassword=CHANGE_ME
keyAlias=gocast
keyPassword=CHANGE_ME
